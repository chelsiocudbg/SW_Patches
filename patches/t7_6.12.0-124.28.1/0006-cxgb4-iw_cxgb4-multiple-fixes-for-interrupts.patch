From cdc1af9f0facf236730670bbf20236f311deb0e3 Mon Sep 17 00:00:00 2001
From: Chelsio Cudbg <chelsiocudbg@users.noreply.github.com>
Date: Thu, 7 May 2026 00:43:59 -0400
Subject: [PATCH 6/6] cxgb4/iw_cxgb4: multiple fixes for interrupts

interrupt changes
error messages
LE interrupt handling
ipv6 fix
---
 drivers/infiniband/hw/cxgb4/provider.c        |   2 +-
 drivers/infiniband/hw/cxgb4/qp.c              |   2 +
 .../net/ethernet/chelsio/cxgb4/cxgb4_main.c   |   1 -
 drivers/net/ethernet/chelsio/cxgb4/sge.c      |  10 +
 drivers/net/ethernet/chelsio/cxgb4/t4_hw.c    |  99 ++++++++--
 drivers/net/ethernet/chelsio/cxgb4/t4_regs.h  | 173 ++++++++++++++++--
 drivers/net/ethernet/chelsio/cxgb4/t4fw_api.h |   5 +
 7 files changed, 255 insertions(+), 37 deletions(-)

diff --git a/drivers/infiniband/hw/cxgb4/provider.c b/drivers/infiniband/hw/cxgb4/provider.c
index b79ca9d41ca3..23f3f2e731c6 100644
--- a/drivers/infiniband/hw/cxgb4/provider.c
+++ b/drivers/infiniband/hw/cxgb4/provider.c
@@ -462,7 +462,7 @@ static int c4iw_query_device(struct ib_device *ibdev, struct ib_device_attr *pro
 	props->max_send_sge = min(T4_MAX_SEND_SGE, T4_MAX_WRITE_SGE);
 	props->max_recv_sge = T4_MAX_RECV_SGE;
 	props->max_srq_sge = T4_MAX_RECV_SGE;
-	props->max_sge_rd = (CHELSIO_CHIP_VERSION(dev->rdev.lldi.adapter_type) >= CHELSIO_T7) ? T7_MAX_RD_SGE : 1;
+	props->max_sge_rd = (roce_mode && (CHELSIO_CHIP_VERSION(dev->rdev.lldi.adapter_type) >= CHELSIO_T7)) ? T7_MAX_RD_SGE : 1;
 	props->max_res_rd_atom = dev->rdev.lldi.max_ird_adapter;
 	props->max_qp_rd_atom = min(dev->rdev.lldi.max_ordird_qp,
 				    c4iw_max_read_depth);
diff --git a/drivers/infiniband/hw/cxgb4/qp.c b/drivers/infiniband/hw/cxgb4/qp.c
index 34ce0c2f860a..d53d021bc5b9 100644
--- a/drivers/infiniband/hw/cxgb4/qp.c
+++ b/drivers/infiniband/hw/cxgb4/qp.c
@@ -4373,6 +4373,7 @@ static int rdma_roce_init(struct c4iw_dev *rhp, struct c4iw_qp *qhp)
 			memcpy(&ud_hdr.ip4.saddr, &ahp->local_ip_addr[3], 4);
 			ud_hdr.ip4.check = ~ib_ud_ip4_csum(&ud_hdr);
 			ud_hdr.grh_present = 0;
+			wqe->u.rocev2_init.rocev2_flags = 0;
 		} else {
 			/* IPv6 header*/
 			ud_hdr.grh_present = 1;
@@ -4383,6 +4384,7 @@ static int rdma_roce_init(struct c4iw_dev *rhp, struct c4iw_qp *qhp)
 			ud_hdr.grh.traffic_class = grh->traffic_class;
 			memcpy(&ud_hdr.grh.destination_gid, &ahp->dest_ip_addr[0], sizeof(struct in6_addr));
 			memcpy(&ud_hdr.grh.source_gid, &ahp->local_ip_addr[0], sizeof(struct in6_addr));
+			wqe->u.rocev2_init.rocev2_flags = FW_ROCEV2_IPV6;
 		}
 
 		/* UDP header */
diff --git a/drivers/net/ethernet/chelsio/cxgb4/cxgb4_main.c b/drivers/net/ethernet/chelsio/cxgb4/cxgb4_main.c
index f867550f263a..de31f6723108 100644
--- a/drivers/net/ethernet/chelsio/cxgb4/cxgb4_main.c
+++ b/drivers/net/ethernet/chelsio/cxgb4/cxgb4_main.c
