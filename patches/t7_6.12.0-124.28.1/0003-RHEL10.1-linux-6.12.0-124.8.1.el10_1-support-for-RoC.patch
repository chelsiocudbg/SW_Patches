+	mmid = (mw->rkey) >> 8;
+	xa_erase_irq(&rhp->mrs, mmid);
+	deallocate_window(&rhp->rdev, mhp->attr.stag, mhp->dereg_skb,
+			mhp->wr_waitp);
+	if (mhp->dereg_skb)
+		kfree_skb(mhp->dereg_skb);
+	pr_debug("ib_mw %p mmid 0x%x ptr %p\n", mw, mmid, mhp);
+	c4iw_put_wr_wait(mhp->wr_waitp);
