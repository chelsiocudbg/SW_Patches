+static int rdma_roce_fini(struct c4iw_dev *rhp, struct c4iw_qp *qhp)
+{
+	struct fw_ri_wr *wqe;
+	int ret, wrlen;
+	struct sk_buff *skb;
+	struct c4iw_ah *ahp;
