+	c.type_to_iqandstindex = htonl(FW_IQ_CMD_TYPE_V(FW_IQ_TYPE_FL_INT_CAP) |
+			FW_IQ_CMD_IQASYNCH_V(0) |
+			FW_IQ_CMD_VIID_V(cxgb4_port_viid(rqp->netdev)) |
