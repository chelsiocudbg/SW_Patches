+		pr_err("%s mbox error %d\n", __func__, ret);
+		goto err;
+	}
+
+	iq->cntxt_id = ntohs(c.iqid);
+	iq->size--;                     /* subtract status entry */
+
+	fl->cntxt_id = ntohs(c.fl0id);
+	fl->avail = fl->pend_cred = 0;
+	fl->pidx = fl->cidx = 0;
+	fl->db = dev->rdev.lldi.db_reg;
