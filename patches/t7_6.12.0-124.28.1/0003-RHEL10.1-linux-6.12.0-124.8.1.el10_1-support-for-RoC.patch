+        RL("RxPackets:", stats.pkts);
+        RL("RxImmPkts:", stats.imm);
+        RL("RxNoMem:", stats.nomem);
+        RL("RxAN:", stats.an);
+        RL("LROmerged:", rspq.lro_mgr.lro_merged);
+        RL("LROpackets:", rspq.lro_mgr.lro_pkts);
