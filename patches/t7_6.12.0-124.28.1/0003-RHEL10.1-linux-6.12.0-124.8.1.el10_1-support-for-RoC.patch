+	memset(&c, 0, sizeof(c));
+	c.op_to_vfn = htonl(FW_CMD_OP_V(FW_EQ_ETH_CMD) | FW_CMD_REQUEST_F |
+			FW_CMD_EXEC_F |
+			FW_IQ_CMD_PFN_V(dev->rdev.lldi.pf) |
+			FW_IQ_CMD_VFN_V(0));
