+			wq->memsize, &(wq->dma_addr),
+			GFP_KERNEL);
+	if (!wq->queue)
+		goto err_free_rqtpool;
+
+	dma_unmap_addr_set(wq, mapping, wq->dma_addr);
+
+	wq->db = rdev->lldi.db_reg;
+	wq->bar2_va = c4iw_bar2_addrs(rdev, wq->qid,
+			CXGB4_BAR2_QTYPE_EGRESS,
