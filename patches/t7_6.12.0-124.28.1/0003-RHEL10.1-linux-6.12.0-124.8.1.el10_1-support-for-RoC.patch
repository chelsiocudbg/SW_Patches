+        if (count == 1) {
+                f = find_first_zero_bit(dev->rdev.fids, dev->rdev.nfids);
+        } else {
+                f = bitmap_find_next_zero_area(dev->rdev.fids, dev->rdev.nfids, 0, count, 3);
