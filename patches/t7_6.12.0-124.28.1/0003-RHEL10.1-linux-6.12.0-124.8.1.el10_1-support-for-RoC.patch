+	c.eqid_pkd = htonl(FW_EQ_ETH_CMD_EQID_V(rqp->txq.cntxt_id));
+	rtnl_lock();
+	ret = cxgb4_wr_mbox(rqp->netdev, &c, sizeof(c), &c);
+	rtnl_unlock();
