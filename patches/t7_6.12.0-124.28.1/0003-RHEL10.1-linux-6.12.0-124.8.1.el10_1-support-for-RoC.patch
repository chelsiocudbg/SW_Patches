+#ifdef IWARP_TOS_SUPPORT
+	u8 tos = cm_id->tos;
+#else
+	u8 tos = 0;
+#endif
+	if ((conn_param->ord > cur_max_read_depth(dev)) ||
+			(conn_param->ird > cur_max_read_depth(dev))) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	ep = alloc_ep(dev, sizeof(*ep), GFP_KERNEL);
+	if (!ep) {
+		pr_err("%s - cannot alloc ep\n", __func__);
+		err = -ENOMEM;
+		goto out;
+	}
