+                        bool range)
+{
+       struct cxgb4_tid_info *t = &adap->tidinfo;
+       int ret;
+
+       if (!cxgb4_hashcoll_tid_out_of_range(adap, hashtid))
+               return cxgb4_hashcoll_tid_insert(adap, hashtid, data, range);
+
+       if (cxgb4_hash_tid_out_of_range(adap, hashtid))
+               return -EOPNOTSUPP;
