+	srqd->pos = 0;
+	srqd->bufsize = count * 180;
+
+	srqd->buf = vmalloc(srqd->bufsize);
+	if (!srqd->buf) {
+		cstor_err(cdev, "unable to allocate buffer, srqd->bufsize %d\n", srqd->bufsize);
