diff --git a/drivers/net/ethernet/chelsio/cxgb4/cxgb4_tid.c b/drivers/net/ethernet/chelsio/cxgb4/cxgb4_tid.c
new file mode 100644
index 000000000000..3fd1cd035f09
--- /dev/null
+++ b/drivers/net/ethernet/chelsio/cxgb4/cxgb4_tid.c
@@ -0,0 +1,934 @@
+/*
+ * This file is part of the Chelsio T4/T5/T6 Ethernet driver for Linux.
+ *
+ * Copyright (C) 2021 Chelsio Communications.  All rights reserved.
+ *
