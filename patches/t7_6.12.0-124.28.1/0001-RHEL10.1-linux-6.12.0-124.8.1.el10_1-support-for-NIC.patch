-	switch (status) {
-	case CPL_ERR_NONE:
-		f->tid = tid;
-		f->pending = 0;
-		f->valid = 1;
-		cxgb4_insert_tid(t, f, f->tid, 0);
-		cxgb4_free_atid(t, ftid);
