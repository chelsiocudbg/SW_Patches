+enum cstor_ioctl_cmd {
+	CSTOR_IOCTL_CMD_QUERY_DEVICE = 1,
+	CSTOR_IOCTL_CMD_ALLOC_PD,
+	CSTOR_IOCTL_CMD_DEALLOC_PD,
+	CSTOR_IOCTL_CMD_REG_MR,
+	CSTOR_IOCTL_CMD_DEREG_MR,
