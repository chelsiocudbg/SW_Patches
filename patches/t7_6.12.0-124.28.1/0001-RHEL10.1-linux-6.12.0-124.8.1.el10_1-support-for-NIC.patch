+               }
+       }
+
+       t4_read_cimq_cfg_core(padap, coreid, base, size, thres);
+
+       cudbg_cim_qcfg_copy(data, num_cim_ibq, num_cim_obq, base, size, thres,
+                           stat, obq_wr);
+       return 0;
+}
