+       struct cxgb4_tid_info_xarray sftids;
+
+       u64 tid_release_head;
+       unsigned int tc_hash_tids_max_prio;
+       spinlock_t tid_release_lock; /* Lock to access TID release list */
+       struct work_struct tid_release_task;
+};
