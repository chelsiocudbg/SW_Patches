+               map = cxgb4_uld_queues_txq_map_get(dev,
+                                                  CXGB4_ULD_TXQ_TYPE_SHARED,
+                                                  uld == CXGB4_ULD_CRYPTO ?
+                                                  uld : CXGB4_ULD_TYPE_TOE);
