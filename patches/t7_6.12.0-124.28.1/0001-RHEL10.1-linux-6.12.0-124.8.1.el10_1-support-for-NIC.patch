+
+#define T4_FL_MAX_PAGE_SIZE 65536
+#define T4_RQT_ENTRY_SHIFT 6
+#define T4_EQ_ENTRY_SIZE 64
+
+#define T4_SQ_NUM_SLOTS 5
+#define T4_SQ_NUM_BYTES (T4_EQ_ENTRY_SIZE * T4_SQ_NUM_SLOTS)
+
