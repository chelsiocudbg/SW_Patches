-	/* If the caller has passed in a Completion Context then we need to
-	 * mark it as a successful completion so they don't stall waiting
-	 * for it.
-	 */
-	if (ctx) {
-		ctx->result = 0;
-		complete(&ctx->completion);
-	}
-	return ret;
