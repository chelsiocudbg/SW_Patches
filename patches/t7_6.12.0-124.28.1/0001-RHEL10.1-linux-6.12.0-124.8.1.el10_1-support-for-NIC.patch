-		case FILTER_DROP:
-			set_tcb_tflag(adap, f, tid, TF_DROP_S, 1, 1);
-			break;
-		case FILTER_SWITCH:
-			set_tcb_tflag(adap, f, tid, TF_LPBK_S, 1, 1);
-			break;
-		}
-
-		break;
