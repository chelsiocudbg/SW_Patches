+void cxgb4_uld_sendpath_qp_free(struct net_device *dev, unsigned int index)
+{
+       struct adapter *adap = netdev2adap(dev);
+
+       ida_free(&adap->uld_inst.res.sendpath_res.qp_ida,
+                index - adap->uld_inst.vres.sendpath_qp.start);
+}
