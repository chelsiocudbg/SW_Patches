@@ -397,6 +398,7 @@ _IOWR(CSTOR_IOCTL_MAGIC, CSTOR_IOCTL_CMD_CREATE_LISTEN, struct cstor_create_list
 
 struct cstor_destroy_listen_cmd {
 	__u32 stid;
