+	}
+
+	if (!(lcsk->port_mask & (1 << csk->port_id))) {
+		cstor_info(cdev, "tid %u, port id %u is not enabled in port mask %#x, "
+			   "lcsk stid %u laddr %pISpc", tid, csk->port_id, lcsk->port_mask,
