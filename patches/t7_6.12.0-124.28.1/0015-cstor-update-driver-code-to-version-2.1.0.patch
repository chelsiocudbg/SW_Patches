diff --git a/drivers/net/ethernet/chelsio/cstor/cstor_ioctl.h b/drivers/net/ethernet/chelsio/cstor/cstor_ioctl.h
index 01b43f29ba58..a07965be6724 100644
--- a/drivers/net/ethernet/chelsio/cstor/cstor_ioctl.h
+++ b/drivers/net/ethernet/chelsio/cstor/cstor_ioctl.h
@@ -32,7 +32,7 @@
