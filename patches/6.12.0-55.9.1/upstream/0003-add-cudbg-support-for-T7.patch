+       u32 stat[4 * (CIM_NUM_IBQ_T7 + CIM_NUM_OBQ_T7)];
+       u16 base[CIM_NUM_IBQ_T7 + CIM_NUM_OBQ_T7];
+       u16 size[CIM_NUM_IBQ_T7 + CIM_NUM_OBQ_T7];
