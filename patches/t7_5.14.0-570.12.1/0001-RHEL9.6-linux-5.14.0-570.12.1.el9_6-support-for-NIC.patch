+        spin_lock_bh(lock);
+        f->valid = 0;
+        /* Remove hash entry */
+        hlist_nulls_del_init_rcu(&f->filter_nulls_node);
+        spin_unlock_bh(lock);
+
+        cxgb4_filter_clear(adap, f);
+}
