+/* Return an error number if the indicated filter isn't writable ...
+ */
+static int cxgb4_filter_writable(struct filter_entry *f)
+{
+        if (f->locked)
+                return -EPERM;
+        if (f->pending)
+                return -EBUSY;
+
+        return 0;
