+static void set_tcp_window(struct cstor_sock *csk, struct port_info *pi)
+{
+	csk->snd_win = snd_win;
+	csk->rcv_win = rcv_win;
+	if (adjust_win && (pi->link_cfg.speed >= 40000)) {
+		csk->snd_win *= 4;
+		csk->rcv_win *= 4;
+	}
+
+	cstor_debug(csk->uctx->cdev, "snd_win %d rcv_win %d\n", csk->snd_win, csk->rcv_win);
+}
